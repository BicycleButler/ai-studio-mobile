-const customTemplatesCollection = new StorageCollection<PromptTemplate>(STORAGE_KEYS.CUSTOM_PROMPT_TEMPLATES);
-
-export function getCustomTemplates(): PromptTemplate[] {
-  return customTemplatesCollection.load();
